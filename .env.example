# URL pública do site (canonical, sitemap, Open Graph). Sem barra no final. Ex.: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial com DDI + DDD, só números. Valor do site oficial:
NEXT_PUBLIC_WHATSAPP_NUMBER=5531985614005

# ---- CRM (somente servidor; nunca use o prefixo NEXT_PUBLIC_) ----
# Endpoint que recebe o lead via POST JSON (webhook do CRM, Make, Zapier, n8n etc.).
CRM_API_URL=
# Chave de acesso. Por padrão é enviada como "Authorization: Bearer <chave>".
CRM_API_KEY=
# Opcional: nome de outro cabeçalho para a chave (ex.: X-Api-Key). Nesse caso a chave vai sem "Bearer".
CRM_AUTH_HEADER=

# ---- Leads pendentes (recomendado em produção) ----
# Redis Upstash (Vercel Marketplace). Se o CRM falhar, o lead fica guardado aqui para reprocessamento.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Token para POST /api/leads/reprocess (gere um valor longo e aleatório).
LEADS_ADMIN_TOKEN=
# Segredo do Vercel Cron (vercel.json roda o reprocessamento 1x/dia no Hobby). A Vercel envia
# "Authorization: Bearer <CRON_SECRET>" quando esta variável existe no projeto.
CRON_SECRET=

# ---- Rastreamento (opcionais) ----
# Use GTM OU GA4 direto. Com GTM definido, configure o GA4 dentro do GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
